<UserControl x:Class="OscTester.AnimationPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="Play a Unity face animation" FontSize="18" FontWeight="SemiBold" />
            <TabControl x:Name="InputModes" Margin="0,8,0,10">
                <TabItem Header="Unity3D bundle">
                    <DockPanel Margin="8" LastChildFill="True">
                        <Button DockPanel.Dock="Left" Content="Browse bundle…" Click="BrowseBundle_Click" />
                        <TextBox x:Name="BundlePath" IsReadOnly="True" AutomationProperties.Name="Selected Unity3D bundle" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Manual files">
                    <StackPanel Margin="8">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" MinWidth="132" Content="Browse .anim…" Click="BrowseClip_Click" />
                            <TextBox x:Name="ClipPath" IsReadOnly="True" AutomationProperties.Name="Selected AnimationClip" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" MinWidth="132" Content="Browse audio…" Click="BrowseAudio_Click" />
                            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="ClearAudio_Click" />
                            <TextBox x:Name="AudioPath" IsReadOnly="True" AutomationProperties.Name="Optional audio path" />
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" MinWidth="132" Content="Browse camera…" Click="BrowseCamera_Click" />
                            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="ClearCamera_Click" />
                            <TextBox x:Name="CameraPath" IsReadOnly="True" AutomationProperties.Name="Optional camera AnimationClip" />
                        </DockPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <DockPanel>
                <Button x:Name="LoadButton" DockPanel.Dock="Left" Content="Load selection" Click="Load_Click" />
                <TextBlock x:Name="ImportStatus" Text="Choose an animation source." VerticalAlignment="Center"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBlock x:Name="AudioStatus" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#88600B" />
            <Separator Margin="0,10,0,9" />
            <TextBlock x:Name="ClipInfo" Text="No clip loaded" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="PlayButton" Content="Play" Click="Play_Click" IsEnabled="False" />
                <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" IsEnabled="False" />
                <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
                <Button x:Name="StepButton" Content="Step +1" Click="Step_Click" IsEnabled="False" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <CheckBox x:Name="SendHumanoidPose" Content="Send humanoid pose data"
                          Checked="SendHumanoidPose_Changed" Unchecked="SendHumanoidPose_Changed" />
                <TextBlock x:Name="HumanoidInfo" Foreground="#4B6078" FontSize="12" Margin="12,0,0,0" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <CheckBox x:Name="SendCameraPose" Content="Send camera pose over OSC" IsEnabled="False"
                          Checked="CameraOption_Changed" Unchecked="CameraOption_Changed" />
                <CheckBox x:Name="FlipCameraDirection" Content="Flip camera direction" IsEnabled="False" Margin="12,0,0,0"
                          ToolTip="Reverse local Z and reflect the camera's aim and roll."
                          Checked="CameraOption_Changed" Unchecked="CameraOption_Changed" />
                <TextBlock x:Name="CameraInfo" Foreground="#4B6078" FontSize="12" Margin="12,0,0,0"
                           Text="Load a clip with camera tracks to enable this option." TextWrapping="Wrap" />
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <StackPanel Margin="0,0,24,0" MinWidth="170">
                    <TextBlock Text="Current time / Total time" Foreground="#4B6078" FontSize="12" />
                    <TextBlock x:Name="TimeInfo" Text="00:00.000 / 00:00.000" FontFamily="Consolas" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Current frame (zero-based)" Foreground="#4B6078" FontSize="12" />
                    <TextBox x:Name="FrameInput" Text="0" Width="146" IsReadOnly="True" FontFamily="Consolas"
                             AutomationProperties.Name="Current frame" KeyDown="FrameInput_KeyDown"
                             LostKeyboardFocus="FrameInput_LostKeyboardFocus" />
                </StackPanel>
                <StackPanel MinWidth="140">
                    <TextBlock Text="Total frames" Foreground="#4B6078" FontSize="12" />
                    <TextBlock x:Name="TotalFrames" Text="0" FontFamily="Consolas" Margin="0,6,0,0" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="Press Enter to jump to a frame while paused or stopped. Start OSC streaming to send the pose to VRChat."
                       Foreground="#4B6078" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
